{
  "name": "rgi-explorer",
  "version": "0.0.0",
  "private": true,
  "description": "A static web map to explore the Randolph Glacier Inventory 7.0 from its cloud-native mirror.",
  "author": {
    "name": "Luis Gentner",
    "email": "luis.gentner@geo.uzh.ch"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "serve": "node scripts/serve.mjs",
    "test": "node --test",
    "smoke": "SMOKE=1 node --test tests/smoke.test.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-mono": "5.3.0",
    "@leeoniya/ufuzzy": "1.0.19",
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "hyparquet": "1.32.0",
    "lucide-static": "1.67.0",
    "maplibre-gl": "6.16.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "es-module-lexer": "3.0.4",
    "jsdom": "30.1.3",
    "typescript": "7.0.2"
  }
}
