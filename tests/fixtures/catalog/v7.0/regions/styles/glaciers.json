{
  "version": 8,
  "name": "Glaciers",
  "metadata": {
    "description": "Glacier outlines and names."
  },
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../../rgi7.0.pmtiles"
    }
  },
  "layers": [
    {
      "source-layer": "regions",
      "id": "regions-outline-2",
      "type": "line",
      "filter": [
        "==",
        [
          "get",
          "level"
        ],
        2
      ],
      "minzoom": 3,
      "paint": {
        "line-color": "#bdbdbd",
        "line-width": 0.5
      },
      "source": "data"
    },
    {
      "source-layer": "regions",
      "id": "regions-outline-1",
      "type": "line",
      "filter": [
        "==",
        [
          "get",
          "level"
        ],
        1
      ],
      "paint": {
        "line-color": "#9e9e9e",
        "line-width": 0.8
      },
      "source": "data"
    },
    {
      "source-layer": "glaciers",
      "id": "glaciers-fill",
      "type": "fill",
      "paint": {
        "fill-color": "#1e88e5",
        "fill-opacity": 0.5
      },
      "source": "data"
    },
    {
      "source-layer": "glaciers",
      "id": "glaciers-outline",
      "type": "line",
      "paint": {
        "line-color": "#0d47a1",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          1.2,
          8,
          0.6,
          12,
          1.0
        ]
      },
      "source": "data"
    },
    {
      "source-layer": "glaciers",
      "id": "glaciers-dots",
      "type": "circle",
      "filter": [
        "in",
        [
          "geometry-type"
        ],
        [
          "literal",
          [
            "Point",
            "MultiPoint"
          ]
        ]
      ],
      "paint": {
        "circle-color": "#1e88e5",
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          1.5,
          6,
          2.5
        ],
        "circle-opacity": 0.85
      },
      "source": "data"
    },
    {
      "source-layer": "region-labels",
      "id": "region-labels-1",
      "type": "symbol",
      "filter": [
        "==",
        [
          "get",
          "level"
        ],
        1
      ],
      "minzoom": 1,
      "maxzoom": 6,
      "layout": {
        "text-field": [
          "get",
          "full_name"
        ],
        "text-font": [
          "Open Sans Bold"
        ],
        "text-size": 12,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#37474f",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      },
      "source": "data"
    },
    {
      "source-layer": "region-labels",
      "id": "region-labels-2",
      "type": "symbol",
      "filter": [
        "==",
        [
          "get",
          "level"
        ],
        2
      ],
      "minzoom": 4,
      "maxzoom": 9,
      "layout": {
        "text-field": [
          "concat",
          [
            "get",
            "o2region"
          ],
          "\n",
          [
            "get",
            "full_name"
          ]
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-size": 11,
        "text-transform": "none",
        "text-letter-spacing": 0
      },
      "paint": {
        "text-color": "#37474f",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      },
      "source": "data"
    },
    {
      "source-layer": "glacier-labels",
      "id": "glacier-labels",
      "type": "symbol",
      "layout": {
        "text-field": [
          "get",
          "display_name"
        ],
        "text-font": [
          "Open Sans Italic"
        ],
        "text-size": 12,
        "symbol-sort-key": [
          "-",
          [
            "get",
            "area_km2"
          ]
        ]
      },
      "paint": {
        "text-color": "#0d2a5c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      },
      "source": "data"
    }
  ]
}
